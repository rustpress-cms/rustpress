[checkbox a "c1" "c2" "c3"]
[checkbox* b use_label_element exclusive "e1" "e2"]
[checkbox c label_first default:1_2 "x" "y" "z"]
[radio d default:2 "r1" "r2" "r3"]
[radio e use_label_element label_first exclusive "only"]
[checkbox f free_text "a" "b" "Other"]
[checkbox g tabindex:5 "t1" "t2" "t3"]
[radio h tabindex:0 "z1" "z2"]
[checkbox i class:boxes id:box-id "i1"]