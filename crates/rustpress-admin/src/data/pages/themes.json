\"theme-autoupdate\">\n\t\t\t<# if ( data.autoupdate.supported ) { #>\n\t\t\t\t<# if ( data.autoupdate.forced === false ) { #>\n\t\t\t\t\t⟦r¦¦Auto-updates disabled⟧\n\t\t\t\t<# } else if ( data.autoupdate.forced ) { #>\n\t\t\t\t\t⟦r¦¦Auto-updates enabled⟧\n\t\t\t\t<# } else if ( data.autoupdate.enabled ) { #>\n\t\t\t\t\t<button type=\"button\" class=\"toggle-auto-update button-link\" data-slug=\"{{ data.id }}\" data-wp-action=\"disable\">\n\t\t\t\t\t\t<span class=\"dashicons dashicons-update spin hidden\" aria-hidden=\"true\"></span><span class=\"label\">⟦r¦¦Disable auto-updates⟧</span>\n\t\t\t\t\t</button>\n\t\t\t\t<# } else { #>\n\t\t\t\t\t<button type=\"button\" class=\"toggle-auto-update button-link\" data-slug=\"{{ data.id }}\" data-wp-action=\"enable\">\n\t\t\t\t\t\t<span class=\"dashicons dashicons-update spin hidden\" aria-hidden=\"true\"></span><span class=\"label\">⟦r¦¦Enable auto-updates⟧</span>\n\t\t\t\t\t</button>\n\t\t\t\t<# } #>\n\t\t\t<# } #>\n\t\t\t<# if ( data.hasUpdate ) { #>\n\t\t\t\t<# if ( data.autoupdate.supported && data.autoupdate.enabled ) { #>\n\t\t\t\t\t<span class=\"auto-update-time\">\n\t\t\t\t<# } else { #>\n\t\t\t\t\t<span class=\"auto-update-time hidden\">\n\t\t\t\t<# } #>\n\t\t\t\t<br />{{auto_update_message}}</span>\n\t\t\t<# } #>\n\t\t\t<div class=\"notice notice-error notice-alt inline hidden\"><p></p></div>\n\t\t</div>\n\t\t\t\t\t<# } #>\n\n\t\t\t\t<p class=\"theme-description\">{{{ data.description }}}</p>\n\n\t\t\t\t<# if ( data.parent ) { #>\n\t\t\t\t\t<p class=\"parent-theme\">\n\t\t\t\t\t\t⟦r¦¦This is a child theme of ⟪%s¦<strong>{{{ data.parent }}}</strong>⟫.⟧\t\t\t\t\t</p>\n\t\t\t\t<# } #>\n\n\t\t\t\t<# if ( data.tags ) { #>\n\t\t\t\t\t<p class=\"theme-tags\"><span>⟦r¦¦Tags:⟧</span> {{{ data.tags }}}</p>\n\t\t\t\t<# } #>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"theme-actions\">\n\t\t\t<div class=\"active-theme\">\n\t\t\t\t<a class=\"button button-compact button-primary customize load-customize hide-if-no-customize\"\n\t\t\t\t\thref=\"{{{ data.actions.customize }}}\"\n\t\t\t\t>⟦r¦¦Customize⟧</a>\n\t\t\t\t{{current_theme_actions}}\t\t\t</div>\n\n\t\t\t<div class=\"inactive-theme\">\n\t\t\t\t<# if ( data.compatibleWP && data.compatiblePHP ) { #>\n\t\t\t\t\t\t\t\t\t\t<a class=\"button button-compact button-primary load-customize hide-if-no-customize\"\n\t\t\t\t\t\thref=\"{{{ data.actions.customize }}}\"\n\t\t\t\t\t\taria-label=\"⟦a¦theme¦Live Preview ⟪%s¦{{ data.name }}⟫⟧\"\n\t\t\t\t\t>⟦r¦¦Live Preview⟧</a>\n\n\t\t\t\t\t<# if ( data.actions.activate ) { #>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"button button-compact activate\"\n\t\t\t\t\t\t\thref=\"{{{ data.actions.activate }}}\"\n\t\t\t\t\t\t\taria-label=\"⟦a¦theme¦Activate ⟪%s¦{{ data.name }}⟫⟧\"\n\t\t\t\t\t\t>⟦r¦¦Activate⟧</a>\n\t\t\t\t\t<# } #>\n\t\t\t\t<# } else { #>\n\t\t\t\t\t\t\t\t\t\t<a class=\"button button-compact button-primary hide-if-no-customize disabled\"\n\t\t\t\t\t\taria-label=\"⟦a¦theme¦Live Preview ⟪%s¦{{ data.name }}⟫⟧\"\n\t\t\t\t\t>⟦r¦¦Live Preview⟧</a>\n\n\t\t\t\t\t<# if ( data.actions.activate ) { #>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"button button-compact disabled\"\n\t\t\t\t\t\t\taria-label=\"⟦a¦theme¦Cannot Activate ⟪%s¦{{ data.name }}⟫⟧\"\n\t\t\t\t\t\t>⟦r¦theme¦Cannot Activate⟧</a>\n\t\t\t\t\t<# } #>\n\t\t\t\t<# } #>\n\t\t\t</div>\n\n\t\t\t<# if ( ! data.active && data.actions['delete'] ) { #>\n\t\t\t\t\t\t\t\t<a class=\"button button-compact delete-theme\"\n\t\t\t\t\thref=\"{{{ data.actions['delete'] }}}\"\n\t\t\t\t\taria-label=\"⟦a¦theme¦Delete ⟪%s¦{{ data.name }}⟫⟧\"\n\t\t\t\t>⟦r¦¦Delete⟧</a>\n\t\t\t<# } #>\n\t\t</div>\n\t</div>\n</script>\n\n\t<script id=\"tmpl-wp-updates-admin-notice\" type=\"text/html\">\n\t\t<div <# if ( data.id ) { #>id=\"{{ data.id }}\"<# } #> class=\"notice {{ data.className }}\"><p>{{{ data.message }}}</p></div>\n\t</script>\n\t<script id=\"tmpl-wp-bulk-updates-admin-notice\" type=\"text/html\">\n\t\t<div id=\"{{ data.id }}\" class=\"{{ data.className }} notice <# if ( data.erro