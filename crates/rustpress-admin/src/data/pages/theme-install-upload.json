ef=\"https://wordpress.org/support/update-php/\">Learn more about updating PHP</a>.\t\t\t\t\t\t\t\t<# } #>\n\t\t\t\t\t\t\t</p></div>\n\t\t\t\t\t\t<# } #>\n\n\t\t\t\t\t\t<div class=\"theme-description\">{{{ data.description }}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"wp-full-overlay-footer\">\n\t\t\t\t<button type=\"button\" class=\"collapse-sidebar button\" aria-expanded=\"true\" aria-label=\"Collapse Sidebar\">\n\t\t\t\t\t<span class=\"collapse-sidebar-arrow\" aria-hidden=\"true\"></span>\n\t\t\t\t\t<span class=\"collapse-sidebar-label\">Collapse</span>\n\t\t\t\t</button>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"wp-full-overlay-main\">\n\t\t<iframe src=\"{{ data.preview_url }}\" title=\"Preview\"></iframe>\n\t</div>\n</script>\n\n\t<script id=\"tmpl-wp-updates-admin-notice\" type=\"text/html\">\n\t\t<div <# if ( data.id ) { #>id=\"{{ data.id }}\"<# } #> class=\"notice {{ data.className }}\"><p>{{{ data.message }}}</p></div>\n\t</script>\n\t<script id=\"tmpl-wp-bulk-updates-admin-notice\" type=\"text/html\">\n\t\t<div id=\"{{ data.id }}\" class=\"{{ data.className }} notice <# if ( data.errorMessage ) { #>notice-error<# } else { #>notice-success<# } #>\">\n\t\t\t<p>\n\t\t\t\t<# if ( data.successMessage ) { #>\n\t\t\t\t\t{{{ data.successMessage }}}\n\t\t\t\t<# } #>\n\t\t\t\t<# if ( data.errorMessage ) { #>\n\t\t\t\t\t<button class=\"button-link bulk-action-errors-collapsed\" aria-expanded=\"false\">\n\t\t\t\t\t\t{{{ data.errorMessage }}}\n\t\t\t\t\t\t<span class=\"screen-reader-text\">\n\t\t\t\t\t\t\tShow more details\t\t\t\t\t\t</span>\n\t\t\t\t\t\t<span class=\"toggle-indicator\" aria-hidden=\"true\"></span>\n\t\t\t\t\t</button>\n\t\t\t\t<# } #>\n\t\t\t</p>\n\t\t\t<# if ( data.errorMessages ) { #>\n\t\t\t\t<ul class=\"bulk-action-errors hidden\">\n\t\t\t\t\t<# _.each( data.errorMessages, function( errorMessage ) { #>\n\t\t\t\t\t\t<li>{{ errorMessage }}</li>\n\t\t\t\t\t<# } ); #>\n\t\t\t\t</ul>\n\t\t\t<# } #>\n\t\t</div>\n\t</script>\n\t\n"
