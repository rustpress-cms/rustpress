# Password of the database user "wordpress"
DB_PASSWORD=change-me
# Public address of the site (for setting up a new site)
SITE_URL=http://localhost:3000
# Folder with the WordPress files (wp-config.php, wp-content/); created for a new site
WORDPRESS_DIR=./wordpress
# Port on the host
PORT=3000
# 0 = read only (no sign-in, no administration)
ALLOW_WRITES=1
