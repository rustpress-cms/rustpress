# Passwort für den Datenbankbenutzer "wordpress"
DB_PASSWORD=bitte-aendern
# Öffentliche Adresse der Seite (für die Einrichtung einer neuen Seite)
SITE_URL=http://localhost:3000
# Ordner mit den WordPress-Dateien (wp-config.php, wp-content/); bei einer neuen Seite wird er angelegt
WORDPRESS_DIR=./wordpress
# Port auf dem Host
PORT=3000
# 0 = nur lesen (kein Login, keine Verwaltung)
ALLOW_WRITES=1
